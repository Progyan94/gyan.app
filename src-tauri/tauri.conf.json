{
  "$schema": "https://tauri.app/schema/v2",
  "productName": "Gyan's Wacky World",
  "version": "1.0.0",
  "identifier": "com.gyanxd25.wackyworld",
  "build": {
    "beforeBuildCommand": "node build.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gyan's Wacky Web World",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
